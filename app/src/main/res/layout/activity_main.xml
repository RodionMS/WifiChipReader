<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="⚙️"
            android:textSize="18sp"
            android:padding="0dp"
            android:backgroundTint="@color/btn_inactive"
            android:textColor="@color/text_primary"
            android:focusable="true"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <Button
            android:id="@+id/tabHardware"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_ttx"
            android:backgroundTint="@color/accent_green"
            android:textColor="#000000"
            android:textStyle="bold"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/tabScanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_scanner"
            android:backgroundTint="@color/btn_inactive"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/tabDebug"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_debug"
            android:backgroundTint="@color/btn_inactive"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:focusable="true"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/layoutHardware"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false">

                    <Button
                        android:id="@+id/btnAnalyze"
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="60dp"
                        android:text="@string/btn_scan"
                        android:textColor="#000000"
                        android:backgroundTint="@color/accent_green"
                        android:focusable="true"
                        android:stateListAnimator="@null"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnShowQR"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="60dp"
                        android:text="@string/btn_qr"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/accent_blue"
                        android:focusable="true"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blockSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:focusable="true"
                    android:clickable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/system_memory" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp" />
                    <TextView android:id="@+id/tvDeviceModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvRam" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvRom" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blockHardware"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:focusable="true"
                    android:clickable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hw_capabilities" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp" />
                    <TextView android:id="@+id/tvBand5G" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvBand6G" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blockStandards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:focusable="true"
                    android:clickable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wifi_standards" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp" />
                    <TextView android:id="@+id/tvWifi1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi7" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blockConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:focusable="true"
                    android:clickable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/current_connection" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp" />

                    <ProgressBar
                        android:id="@+id/pbQuality"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/accent_green"
                        android:layout_marginBottom="8dp"/>

                    <TextView android:id="@+id/tvQualityScore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quality_wait" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginBottom="10dp" />
                    <TextView android:id="@+id/tvConnectionDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:lineSpacingExtra="5dp" />

                    <com.example.wifichipreader.SignalGraphView
                        android:id="@+id/graphSignal"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/layoutScanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAutoScanIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_scan"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:id="@+id/containerNetworks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/layoutDebug"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <!-- ОБНОВЛЕННЫЙ БЛОК: Кнопки Базы Данных с темами и языками -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false">

                    <Button
                        android:id="@+id/btnShowHistory"
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:layout_height="60dp"
                        android:text="@string/btn_show_history"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/accent_green"
                        android:focusable="true"
                        android:stateListAnimator="@null"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnClearHistory"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="60dp"
                        android:text="@string/btn_clear_history"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="@color/error_red"
                        android:focusable="true"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnExportReport"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/btn_export"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/accent_purple"
                    android:focusable="true"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/raw_data"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvDebugConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/console_bg"
                    android:padding="12dp"
                    android:textColor="@color/console_text"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:text="@string/status_logs" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>