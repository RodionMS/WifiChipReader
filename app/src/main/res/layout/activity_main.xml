<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WiFi Hardware Pro"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <Button
            android:id="@+id/tabHardware"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ТТХ"
            android:backgroundTint="#4CAF50"
            android:textColor="#000000"
            android:textStyle="bold"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/tabScanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ЭФИР"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/tabDebug"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DEBUG"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:focusable="true"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/layoutHardware"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <Button
                    android:id="@+id/btnAnalyze"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Просканировать систему"
                    android:textColor="#000000"
                    android:backgroundTint="#4CAF50"
                    android:focusable="true"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/blockHardware"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E1E1E"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:focusable="true"
                    android:clickable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="АППАРАТНЫЕ ВОЗМОЖНОСТИ (INFO ⓘ)" android:textColor="#888888" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp" />
                    <TextView android:id="@+id/tvBand5G" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E0E0E0" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvBand6G" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E0E0E0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blockStandards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E1E1E"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:focusable="true"
                    android:clickable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ПОДДЕРЖКА СТАНДАРТОВ (INFO ⓘ)" android:textColor="#888888" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp" />
                    <TextView android:id="@+id/tvWifi1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/tvWifi7" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blockConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E1E1E"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:focusable="true"
                    android:clickable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ТЕКУЩЕЕ СОЕДИНЕНИЕ (INFO ⓘ)" android:textColor="#888888" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp" />

                    <ProgressBar
                        android:id="@+id/pbQuality"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#4CAF50"
                        android:layout_marginBottom="8dp"/>

                    <TextView android:id="@+id/tvQualityScore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Качество связи: Ожидание..." android:textColor="#E0E0E0" android:textStyle="bold" android:layout_marginBottom="10dp" />
                    <TextView android:id="@+id/tvConnectionDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#AAAAAA" android:lineSpacingExtra="5dp" />

                    <!-- НОВЫЙ КОМПОНЕНТ: Живой график сигнала -->
                    <com.example.wifichipreader.SignalGraphView
                        android:id="@+id/graphSignal"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/layoutScanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAutoScanIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Автообновление эфира: каждые 8 сек..."
                    android:textColor="#03A9F4"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:id="@+id/containerNetworks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/layoutDebug"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <Button
                    android:id="@+id/btnExportReport"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Экспорт в TXT"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#673AB7"
                    android:focusable="true"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="СЫРЫЕ СИСТЕМНЫЕ ДАННЫЕ"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvDebugConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#000000"
                    android:padding="12dp"
                    android:textColor="#00FF00"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:text="Сбор логов..." />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>